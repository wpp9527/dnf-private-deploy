# 基础
TZ=Asia/Shanghai
PROJECT_NAME=dnf-llnut
COMPOSE_PROJECT_NAME=dnf-llnut

# 镜像
DNF_IMAGE=llnut/dnf:debian13-qf1031-latest

# 端口映射
PORT_SUPERVISOR=2000
PORT_GAME_LOGIN=3000
PORT_GAME_GATE=5505
PORT_ADMIN=882
PORT_WORLD_TCP=7001
PORT_WORLD_UDP=7001
PORT_CHANNEL_TCP=7300
PORT_CHANNEL_UDP=7300
PORT_CAIN_TCP=30011
PORT_CAIN_UDP=31011
PORT_CAIN2_TCP=30052
PORT_CAIN2_UDP=31052

# 敏感项占位（真实值不要提交）
PUBLIC_IP=REDACTED
DNF_DB_ROOT_PASSWORD=REDACTED
DNF_DB_GAME_PASSWORD=REDACTED
MAIN_MYSQL_ROOT_PASSWORD=REDACTED
GATE_AES_KEY=REDACTED
TS_AUTH_KEY=REDACTED
NB_SETUP_KEY=REDACTED
WEB_PASS=REDACTED

# 新后台只读适配账号（真实密码不要提交）
LLNUT_MYSQL_HOST=127.0.0.1
LLNUT_MYSQL_PORT=3306
LLNUT_MYSQL_READONLY_USER=dnf_readonly
LLNUT_MYSQL_READONLY_PASSWORD=REDACTED

# 新后台适配模式：demo 或 live-readonly
LLNUT_MODE=demo
